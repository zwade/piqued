{
  "name": "@piqued/client",
  "version": "0.8.1",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "prepublish": "yarn r client:prepublish"
  },
  "r": {
    "client:prepublish": "yarn tsc && chmod +x ./dist/bin/piqued-migrate.js",
    "client:watch": "yarn tsc -w",
    "client:deploy": "yarn r client:prepublish && npm publish --access public"
  },
  "peerDependencies": {
    "pg": "*",
    "pg-cursor": "*",
    "zod": "*"
  },
  "devDependencies": {
    "@types/pg": "^8.6.5",
    "@types/pg-cursor": "^2.7.2",
    "pg": "^8.16.0",
    "pg-cursor": "^2.15.0",
    "prettier": "^3.2.5",
    "typescript": "^5.4.3",
    "zod": "^3.24.4"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "bin": {
    "piqued-migrate": "./dist/bin/piqued-migrate.js",
    "pqm": "./dist/bin/piqued-migrate.js"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "smol-toml": "^1.3.4"
  }
}
