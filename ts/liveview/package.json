{
  "name": "@piqued/liveview",
  "version": "0.8.0-beta.8",
  "packageManager": "yarn@4.13.0",
  "type": "module",
  "scripts": {
    "prepublish": "yarn r liveview:prepublish"
  },
  "r": {
    "liveview:prepublish": "yarn r lint --fix && yarn tsc",
    "liveview:deploy": "yarn r liveview:prepublish && npm publish --access public"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "devDependencies": {
    "typescript": "^5.4.3"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ]
}